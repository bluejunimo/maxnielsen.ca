doctype html
html(lang="en")
	// HTML Head
	+project_head('Astra - Max Nielsen')

	body
		// Header
		include includes/header

		// Title and nav(?)
		picture.project-hero-img.serendipity-hero-img
			source(
				srcset="../../img/design/astra/menu.webp" 
				media="(min-width: 58.125rem)"
				)
			source(
				srcset="../../img/design/astra/menu.webp" 
				media="(max-width: 58.125rem)"
				)
			img(src="../../img/design/astra/menu.webp")
		
		// About Me
		#main.two-col
			aside(id="table_of_contents")
				h1(id="table_of_contents_title") Astra
				p.tagline
					| An AR interface and everyday artifacts from a future moon colony monopoly.
				div(id="project_details")
